# GEMINI_API_KEY: Required for Gemini AI API calls.
# Use VITE_ prefix for client-side Vite apps.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# SUPABASE_URL: Your Supabase project URL (Settings -> API -> Project URL)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_ANON_KEY: Your Supabase anon/public key (Settings -> API -> anon key)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# SCRAPINGBEE_API_KEY: Required for fetching Instagram/TikTok reel content.
# Get your key at https://app.scrapingbee.com/
VITE_SCRAPINGBEE_API_KEY="YOUR_SCRAPINGBEE_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://ais-dev-xlfiwzdy2aozqruhtdmcna-385754510903.europe-west1.run.app"
